# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Rust
/karembo-backend/target/
**/target/

# JetBrains local datasource config can contain credentials
.idea/dataSources.local.xml
.idea/dataSources/
.idea/workspace.xml

# Subproject build output and dependencies. The starter .gitignore anchored these
# to the repo root (/node_modules, /.next), which does not match the actual
# locations under karembo-frontend/.
**/node_modules/
**/.next/
**/target/
